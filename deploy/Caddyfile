{
	admin off
	servers {
		timeouts {
			read_header 5s
			read_body 30s
			write 60s
			idle 60s
		}
		max_header_size 16KB
	}
}

{$MEIBO_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 33554432
	}
	reverse_proxy app:4317 {
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -X-Forwarded-For
	}
}
