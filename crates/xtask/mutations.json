    {
      "label": "houjin: 重み逆転",
      "file": "crates/core/src/houjin.rs",
      "find": "i % 2 == 0",
      "replace": "i % 2 != 0"
    },
    {
      "label": "houjin: 剰余削除",
      "file": "crates/core/src/houjin.rs",
      "find": "9 - sum % 9",
      "replace": "9 - sum % 8"
    },
    {
      "label": "houjin: 検査省略",
      "file": "crates/core/src/houjin.rs",
      "find": "bytes[0] - b'0' != check_digit(&bytes[1..])",
      "replace": "false"
    },
    {
      "label": "houjin: 長さ境界",
      "file": "crates/core/src/houjin.rs",
      "find": "number.len() != 13",
      "replace": "number.len() != 12"
    },
    {
      "label": "houjin: ASCII検査省略",
      "file": "crates/core/src/houjin.rs",
      "find": "!number.bytes().all(|b| b.is_ascii_digit())",
      "replace": "false"
    },
    {
      "label": "houjin: 6帯を7帯へ",
